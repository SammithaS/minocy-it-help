GOOGLE_GENERATIVE_AI_API_KEY=
# AI Gateway id; empty = the auto-created "default" gateway (account comes from the AI binding)
AI_GATEWAY_ID=
# Optional model overrides
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
RESEND_API_KEY=
EMAIL_FROM=help@yourdomain
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:5173
IT_ADMIN_EMAIL=
# Days a manager has to approve an access request (default 7)
ACCESS_APPROVAL_DAYS=
# Hours before the assistant checks in after fixing something (default 24)
FOLLOW_UP_HOURS=
# Knowledge-gap agent runs per 24 h (default 50)
KB_GAP_DAILY_BUDGET=
# Access connectors (optional): GitHub, Okta, Jira/Confluence
GITHUB_TOKEN=
OKTA_DOMAIN=
OKTA_API_TOKEN=
ATLASSIAN_SITE=
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
