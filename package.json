{
  "name": "minocy-it-help",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "echo \"Ask before deploying (see README)\" && exit 1",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "tsx scripts/seed.ts && wrangler d1 execute DB --local --file=.wrangler/seed.sql",
    "db:reset": "pnpm db:migrate && pnpm db:seed",
    "kb:check": "tsx scripts/check-kb.ts",
    "kb:ingest": "tsx scripts/ingest-kb.ts",
    "eval:retrieval": "tsx scripts/eval.ts retrieval",
    "eval": "tsx scripts/eval.ts",
    "kb:search": "tsx scripts/search-kb.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@tanstack/react-query": "5.108.0",
    "@tanstack/react-router": "1.170.46",
    "better-auth": "1.7.26",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.19",
    "lucide-react": "1.75.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.0",
    "@cloudflare/vitest-plugin": "1.8.5",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/router-plugin": "1.169.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "gray-matter": "4.0.3",
    "promptfoo": "0.126.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "wrangler": "4.165.0"
  }
}
