{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minocy-it-help",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agents/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minocy-it-help",
      // Placeholder for local dev; replaced with the real id at deploy time.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Vectorize and Workers AI have no local simulator: `remote: true` makes `pnpm dev`
  // and scripts use the real (free-tier) services on your Cloudflare account.
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "it-kb", "remote": true }],
  "ai": { "binding": "AI", "remote": true },
  "durable_objects": {
    "bindings": [{ "name": "SUPPORT_AGENT", "class_name": "SupportAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SupportAgent"] }],
  "vars": {
    "APP_URL": "http://localhost:5173",
    "EMAIL_FROM": "help@example.com"
  }
  // Later phases add: TICKET_BOARD, workflows, EMAIL, cron triggers.
}
