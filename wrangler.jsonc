{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minocy-it-help",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agents/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minocy-it-help",
      // Placeholder for local dev; replaced with the real id at deploy time.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_URL": "http://localhost:5173",
    "EMAIL_FROM": "help@example.com"
  }
  // Later phases add: VECTORIZE, AI, SUPPORT_AGENT, TICKET_BOARD, workflows, EMAIL, cron triggers.
}
