{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minocy-it-help",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agents/*", "/mcp"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minocy-it-help",
      // Placeholder for local dev; replaced with the real id at deploy time.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Vectorize and Workers AI have no local simulator: `remote: true` makes `pnpm dev`
  // and scripts use the real (free-tier) services on your Cloudflare account.
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "it-kb", "remote": true }],
  "ai": { "binding": "AI", "remote": true },
  "durable_objects": {
    "bindings": [
      { "name": "SUPPORT_AGENT", "class_name": "SupportAgent" },
      { "name": "TICKET_BOARD", "class_name": "TicketBoard" },
      { "name": "TRIAGE_AGENT", "class_name": "TriageAgent" },
      { "name": "KB_GAP_AGENT", "class_name": "KbGapAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SupportAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["TicketBoard"] },
    { "tag": "v3", "new_sqlite_classes": ["TriageAgent"] },
    { "tag": "v4", "new_sqlite_classes": ["KbGapAgent"] }
  ],
  // Durable ticket lifecycle: notify → SLA timers → wait for resolution → confirm → close.
  "workflows": [
    { "name": "ticket-workflow", "binding": "TICKET_WORKFLOW", "class_name": "TicketWorkflow" },
    // Access request: manager approves by signed email link → mock provisioning → notify.
    { "name": "access-request-workflow", "binding": "ACCESS_WORKFLOW", "class_name": "AccessRequestWorkflow" },
    // KB editor saves and approved proposals: embed → Vectorize → D1 (article, steps, FTS).
    { "name": "kb-reindex-workflow", "binding": "KB_REINDEX_WORKFLOW", "class_name": "KbReindexWorkflow" }
  ],
  // Cloudflare Email Service: team mailboxes must be verified destination addresses (free).
  "send_email": [{ "name": "EMAIL" }],
  // Daily digest to IT admins at 09:00 IST (03:30 UTC).
  "triggers": { "crons": ["30 3 * * *"] },
  "vars": {
    "APP_URL": "http://localhost:5173",
    "EMAIL_FROM": "help@minocy.example",
    // "log" = render + store in the console Outbox only (no domain needed).
    // "live" = team mail via Email Service, employee mail via Resend (needs a domain; see docs).
    "EMAIL_TRANSPORT": "log",
    // Replies to ticket+INC-1031@<INBOUND_DOMAIN> become ticket comments (Email Routing → email()).
    "INBOUND_DOMAIN": "minocy.example"
  }
}
